{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flux-legacy-redirect",
  "main": "index.ts",
  "account_id": "1f032eb58af6df633b05878a2abb915d",
  "compatibility_date": "2026-03-03",
  "observability": {
    "enabled": true,
  },
  // Takes over the retired hosts. Each must first be detached from the `flux`
  // Worker (Workers & Pages → flux → Settings → Domains & Routes), and any edge
  // redirect rule for it removed — Redirect Rules run before Workers.
  "routes": [
    { "pattern": "flux.kapadiya.net", "custom_domain": true },
    { "pattern": "sudo.kapadiya.net", "custom_domain": true },
  ],
}
